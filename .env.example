# ==============================================================================
# レスバト (debata) 環境変数テンプレート
# 使い方: このファイルを `.env` にコピーし、実際の値を設定してください。
#   cp .env.example .env
# ※ `.env` は `.gitignore` により Git 管理対象外となっています。
# ==============================================================================

# --- Supabase 接続設定（必須） ---
P_VAR_URL="https://your-project-id.supabase.co"
P_VAR_ANONKEY="your-supabase-anon-key"

# --- RevenueCat 課金設定（任意：広告非表示サブスクリプション検証時） ---
REVENUECAT_GOOGLE="goog_your_revenuecat_public_api_key"
REVENUECAT_APPLE="appl_your_revenuecat_public_api_key"

# ==============================================================================
# Supabase Edge Functions 用シークレット（`supabase secrets set` で設定）
# ==============================================================================
# SUPABASE_URL="https://your-project-id.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# TEST_DEEPSEEK_API_KEY="sk-your-deepseek-api-key"
# NOTIFY_SECRET="your-notify-trigger-shared-secret"
